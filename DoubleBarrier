## Problema de doble barrera

El siguiente codigo tiene como objetivo calcular la transmisión electronica a traves de dos barreras de potencial.
"""

import numpy as np
import matplotlib.pyplot as plt

# Constantes Físicas
hbar = 1.05457e-34      # Js
e = 1.60217e-19         # C
m = 9.10938e-31         # kg

# Parametros del potencial
V_0 = 14e-3 * e         # 14 meV
V_1 = 150e-3 * e         # 150 meV
L = np.sqrt(20/(2*m*V_0)) * hbar            # Ancho de cada región
pos_x = np.array([0, 0.5*L, 1*L, 1.5*L]) # x_1, x_2, x_3, x_4

# Funciones Auxiliares
def my_sqrt(x):
    """ Calcula la raíz cuadrada para casos complejos sin errores"""
    return np.sqrt(x) if x >= 0 else 1j * np.sqrt(-x)
def k(E,V):
  """ Calcula el número de onda para una energía E y potencial V """
  return my_sqrt(2*m*(E - V)) / hbar

def M(x,xi,omega):
    # Coeficientes de la matriz de transferencia M
    a = np.exp(1j * x * (omega - xi)) * (1.0 + omega/xi)
    b = np.exp(-1j * x * (omega + xi)) * (1.0 - omega/xi)
    c = np.exp(1j * x * (omega + xi)) * (1.0 - omega/xi)
    d = np.exp(-1j * x * (omega - xi)) * (1.0 + omega/xi)
    return 0.5 * np.array([[a, b], [c, d]], dtype=complex)
def Calcular_Coeficientes(E):
  """
  Calcula coeficientes de transmisión y reflexión para una energía
  incidente E. Retorna T, R.
  """
  try:

    # 2. Calcular números de onda en cada región
    k0 = k(E, 0)
    k1 = k(E, V_0)
    k2 = k(E,V_1)

    M_tot = M(pos_x[0], k0, k1) @ np.linalg.inv(M(pos_x[1], k0, k1)) @ M(pos_x[2], k0, k2) @ np.linalg.inv(M(pos_x[3], k0, k2))

    t = 1/M_tot[0, 0]
    r = M_tot[1, 0]/ M_tot[0,0]

    T = np.abs(t)**2
    R = np.abs(r)**2

   # if not np.isclose(T + R, 1.0, rtol = 1e-5, atol = 1e-10):
   #   print(f"Advertencia: T+R = {T + R:.8f} para E = {E/e*1000:.2f} meV")

    return T,R, False

  except Exception as err:
    print(f"Error en E = {E/e*1000:.2f} meV: {e}")
    return 0.0, 1.0, True

E_0 = 100e-3 * e # 100 meV
print("=" * 50)
print("Doble Barrera Cúantica")
print(f"V_0 = {V_0/e*1000:.1f} meV")
print(f"V_1 = {V_1/e*1000:.1f} meV")
print("=" * 50)

T, R, error = Calcular_Coeficientes(E_0)
if not error:
  print(f"\nPara E = {E_0/e*1000:.2f} meV:")
  print(f" Coeficiente de transmisión (T): {T:.8f}")
  print(f" Coeficiente de reflexión (R): {R:.8f}")
  print(f"Suma (T+R): {T + R:.2f}")
  print(f"Conservación: {np.isclose(T+R, 1.0, atol = 1e-10)}")
else:
  print(f"\nError en el cálculo para E = {E_0/e*1000:.2f} meV")

E_min = V_0*1.01 - E_0
E_max = V_1*0.99 + 2*E_0
energias = np.linspace(-1e-2*e, E_max, 5000)

T_vals = np.zeros_like(energias)
R_vals = np.zeros_like(energias)

for i, E in enumerate(energias):
  T_vals[i], R_vals[i], _ = Calcular_Coeficientes(E)

from scipy.signal import find_peaks
peaks, properties = find_peaks(T_vals, height=0.5, prominence=0.1)

print(f"\nSe encontraron {len(peaks)} resonancias:")
for peak in peaks:
    E_peak = energias[peak]
    T_peak = T_vals[peak]
    print(f"  • E = {E_peak/e*1000:.4f} meV, T = {T_peak:.6f}")

plt.figure(figsize = (14, 8), dpi = 100)
plt.plot(energias/e*1000, T_vals, "b-", linewidth = 1.5, label = "Transmisión")
#plt.plot(energias/e*1000, R_vals, "r--", linewidth = 1.5, alpha = 0.7, label = "Reflexión")
plt.axhline(y = 1.0, color = "k", linestyle = "--", alpha = 0.5, label = "Conservación")
plt.axvline(x = V_0/e*1000, color = "g", linestyle = "--", alpha = 0.5, label = f"V_0 = {V_0/e*1000:.1f} meV")
plt.axvline(x = V_1/e*1000, color = "m", linestyle = "--", alpha = 0.5, label = f"V_1 = {V_1/e*1000:.1f} meV")
plt.axvline(x = E_0/e*1000, color = "orange", linestyle = "--", alpha = 0.5, label = f"E_0 = {E_0/e*1000:.2f} meV")

plt.xlabel("Energía (meV)", fontsize = 12)
plt.ylabel("Coeficiente", fontsize = 12)
plt.title("Coeficientes de transmisión de reflexión", fontsize = 16)
plt.grid(True, linestyle = "--", alpha = 0.5)
plt.legend(loc = "best",fontsize = 12)
plt.show()
